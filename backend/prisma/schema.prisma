generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ============================

enum Role {
  ADMIN
  STAFF
}

enum CabanaStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  PHONE
  WALK_IN
}

enum ActivityType {
  SAFARI
  OUTDOOR_ACTIVITY
}

enum ActivityBookingStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

// ======================= STAFF (Admin / Staff) =======================

model User {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  fullName            String
  email               String?   @unique
  passwordHash        String
  role                Role      @default(STAFF)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reservationsCreated Reservation[]
  activityBookings    ActivityBooking[]
  barOrders           BarOrder[]
  fnbOrders           FnbOrder[]
  payments            Payment[]
  adjustments         BillAdjustment[]
  invoices            Invoice[]
  blockedPeriods      BlockedPeriod[]
  auditLogs           AuditLog[]
}

// ===================== CABANA AND STAY PACKAGES =====================

// One row today. Kept as a table so more cabanas can be added later.
model Cabana {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  maxGuests   Int
  facilities  String[]
  photoUrls   String[]
  status      CabanaStatus @default(AVAILABLE)
  updatedAt   DateTime     @updatedAt

  reservations   Reservation[]
  blockedPeriods BlockedPeriod[]
}

// "Couple" and "Family". Price, limits and inclusions only; availability depends on dates, not package.
model StayPackage {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  description   String?
  pricePerNight Decimal  @db.Decimal(10, 2)
  maxAdults     Int
  maxChildren   Int      @default(0)
  inclusions    String[]
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  reservations Reservation[]
}

// Maintenance blocks. End date is exclusive, like check-out. No overlaps (see extra_constraints.sql).
model BlockedPeriod {
  id          Int      @id @default(autoincrement())
  cabanaId    Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String
  createdById Int
  createdAt   DateTime @default(now())

  cabana    Cabana @relation(fields: [cabanaId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])
}

// ===================== GUESTS AND RESERVATIONS =====================

// A person. Kept across stays so history is available. Has no login of its own.
model Guest {
  id        Int      @id @default(autoincrement())
  idNumber  String   @unique // NIC or passport
  fullName  String
  address   String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
}

// One booking by one party (couple or family). Portal login = reference + portal password.
model Reservation {
  id           Int               @id @default(autoincrement())
  reference    String            @unique // e.g. RFH-1024, generated by the API
  guestId      Int
  cabanaId     Int
  packageId    Int
  checkInDate  DateTime          @db.Date
  checkOutDate DateTime          @db.Date // exclusive: guest leaves on this date
  adults       Int
  children     Int               @default(0)
  nightlyRate  Decimal           @db.Decimal(10, 2) // copied from the package at booking time
  status       ReservationStatus @default(PENDING)
  source       BookingSource
  notes        String?
  cancelReason String?
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  // Guest portal access for this stay
  portalPasswordHash String?
  portalActive       Boolean @default(false) // true from check-in until check-out
  mustChangePassword Boolean @default(true)

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guest     Guest       @relation(fields: [guestId], references: [id])
  cabana    Cabana      @relation(fields: [cabanaId], references: [id])
  package   StayPackage @relation(fields: [packageId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])

  activityBookings ActivityBooking[]
  barOrders        BarOrder[]
  fnbOrders        FnbOrder[]
  payments         Payment[]
  adjustments      BillAdjustment[]
  invoice          Invoice?

  @@index([checkInDate, checkOutDate])
  @@index([status])
  @@index([guestId])
}

// ===================== ACTIVITIES AND SAFARIS =====================

model Activity {
  id              Int          @id @default(autoincrement())
  name            String
  type            ActivityType
  description     String?
  durationMinutes Int?
  unitPrice       Decimal      @db.Decimal(10, 2) // per person
  maxParticipants Int
  photoUrls       String[]
  isActive        Boolean      @default(true)
  updatedAt       DateTime     @updatedAt

  bookings ActivityBooking[]
}

model ActivityBooking {
  id                 Int                   @id @default(autoincrement())
  reservationId      Int
  activityId         Int
  scheduledAt        DateTime
  participants       Int
  unitPriceAtBooking Decimal               @db.Decimal(10, 2)
  totalCharge        Decimal               @db.Decimal(10, 2)
  status             ActivityBookingStatus @default(BOOKED)
  createdById        Int
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
  activity    Activity    @relation(fields: [activityId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@index([reservationId])
  @@index([scheduledAt])
}

// ===================== FOOD, BEVERAGE AND BAR =====================

model MenuCategory {
  id        Int    @id @default(autoincrement())
  name      String @unique
  sortOrder Int    @default(0)

  items MenuItem[]
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  // Customization choices, e.g. [{"name":"Spice level","choices":["Mild","Medium","Hot"]}]
  options     Json?
  photoUrl    String?
  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  category   MenuCategory   @relation(fields: [categoryId], references: [id])
  orderItems FnbOrderItem[]
}

model FnbOrder {
  id            Int         @id @default(autoincrement())
  reservationId Int
  status        OrderStatus @default(PLACED)
  specialNotes  String?
  totalCost     Decimal     @db.Decimal(10, 2)
  placedByGuest Boolean     @default(true)
  placedById    Int? // staff user, when placed on behalf of the guest
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reservation Reservation    @relation(fields: [reservationId], references: [id])
  placedBy    User?          @relation(fields: [placedById], references: [id])
  items       FnbOrderItem[]

  @@index([reservationId])
  @@index([status])
}

model FnbOrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int
  menuItemId       Int
  quantity         Int
  unitPriceAtOrder Decimal @db.Decimal(10, 2)
  customization    String?

  order    FnbOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model BarItem {
  id        Int      @id @default(autoincrement())
  name      String
  unitPrice Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  orders BarOrder[]
}

model BarOrder {
  id               Int      @id @default(autoincrement())
  reservationId    Int
  barItemId        Int
  quantity         Int
  unitPriceAtOrder Decimal  @db.Decimal(10, 2)
  totalCost        Decimal  @db.Decimal(10, 2)
  recordedById     Int
  createdAt        DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  barItem     BarItem     @relation(fields: [barItemId], references: [id])
  recordedBy  User        @relation(fields: [recordedById], references: [id])

  @@index([reservationId])
}

// ===================== BILLING =====================

// The running bill is calculated from: nights x nightlyRate + activity bookings + bar orders
// + F&B orders + adjustments - payments. Only the final invoice is stored as a snapshot.

// Extra charges (positive) and discounts (negative), always with a reason.
model BillAdjustment {
  id            Int      @id @default(autoincrement())
  reservationId Int
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  reason        String?
  createdById   Int
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])

  @@index([reservationId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  reservationId Int
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  isAdvance     Boolean       @default(false)
  paidAt        DateTime      @default(now())
  note          String?
  recordedById  Int

  reservation Reservation @relation(fields: [reservationId], references: [id])
  recordedBy  User        @relation(fields: [recordedById], references: [id])

  @@index([reservationId])
}

// Created at check-out. Figures are copied so later price changes cannot alter it.
model Invoice {
  id            Int      @id @default(autoincrement())
  reservationId Int      @unique
  invoiceNumber String   @unique
  accommodation Decimal  @db.Decimal(10, 2)
  activities    Decimal  @db.Decimal(10, 2)
  bar           Decimal  @db.Decimal(10, 2)
  foodBeverage  Decimal  @db.Decimal(10, 2)
  adjustments   Decimal  @db.Decimal(10, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  totalPaid     Decimal  @db.Decimal(10, 2)
  issuedAt      DateTime @default(now())
  issuedById    Int

  reservation Reservation @relation(fields: [reservationId], references: [id])
  issuedBy    User        @relation(fields: [issuedById], references: [id])
}

// ===================== SYSTEM =====================

// Hotel phone, WhatsApp number, check-in/out times, tax %, public notices, etc.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // e.g. RESERVATION_UPDATED
  entity    String // e.g. Reservation
  entityId  Int?
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}